# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Комментарии пишите только на отдельных строках.

# --- сервер шлюза ---
# ключ ProxyAPI из личного кабинета
UPSTREAM_KEY=
UPSTREAM_BASE=https://api.proxyapi.ru/v1
# наша цена = цена поставщика × MARKUP
MARKUP=1.35
PORT=8790

# --- сайт на GitHub Pages (npm run build:site) ---
# адрес сервера шлюза, только https://
API_BASE_URL=
# свой домен вместо *.github.io, если появится
SITE_DOMAIN=

# --- оферта и политика ---
BRAND=Шлюз
SELLER_NAME=
SELLER_INN=
CONTACT_EMAIL=
# хостинг сервера в России, например: Timeweb Cloud
HOSTING_NAME=
UPSTREAM_NAME=ProxyAPI (ИП Баринбойм А. Н., Россия)
